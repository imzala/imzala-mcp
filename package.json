{
  "name": "@imzala/mcp-server",
  "version": "1.10.0",
  "description": "İmzala MCP sunucusu: sözleşme listesi, durumu, oluşturma ve iptali, şablonlar, kişiler, imzalı PDF indirme, hatırlatma ve Eser Tasdik. API anahtarıyla çalışır.",
  "type": "module",
  "bin": {
    "imzala-mcp": "dist/bin/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-preflight.mjs",
    "prepublishOnly": "npm run spec:check && npm run build && npm run test && npm run e2e",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
